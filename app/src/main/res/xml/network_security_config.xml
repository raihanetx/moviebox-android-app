<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext (HTTP) by default. All API traffic is HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Known production hosts the app talks to. Subdomains included. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">h5-api.aoneroom.com</domain>
        <domain includeSubdomains="true">themoviebox.xyz</domain>
    </domain-config>

    <!-- Optional: allow cleartext only on the loopback interface for local debugging. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain>localhost</domain>
        <domain>127.0.0.1</domain>
    </domain-config>
</network-security-config>
